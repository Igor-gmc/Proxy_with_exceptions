# Publish only reviewed source roots and documentation. Local evidence stays local.
/*
!/.gitignore
!/.gitattributes
!/.editorconfig
!/ProxyBridge.slnx
!/ARCHITECTURE.md
!/README.md
!/README.en.md
!/README.txt
!/HELP.txt
!/CHANGELOG.md
!/THIRD-PARTY.txt
!/Version.props
!/build.ps1
!/Recover-Internet.cmd
!/Start-Emulator-Proxy.cmd
!/ProxyBridge/
!/native/
!/tests/
!/integration/
!/tools/
!/licenses/
!/SECURITY.md
!/docs/
/docs/*
!/docs/IPV6-DIRECT.md

# Build output, packages and local runtime state (including encrypted settings).
**/bin/
**/obj/
**/artifacts/
**/dist/
**/release/
**/vendor/
**/runtime/
**/incidents/
**/node_modules/
**/.vs/
**/.idea/
**/.vscode/
**/__pycache__/
*.exe
*.dll
*.pdb
*.obj
*.lib
*.exp
*.zip
*.7z
*.tar
*.gz
*.log
*.jsonl
*.dmp
*.etl
*.dat
*.tmp
*.bak
*.user
*.suo
*.cache

# Never commit environments, credentials, VPN profiles or private keys.
.env
.env.*
*.env
*.env.*
**/.aws/
**/.ssh/
**/.codex/
**/.agents/
*credentials*
*secrets*
settings.json
appsettings.Local.json
*.ovpn
*.pem
*.key
*.pfx
*.p12
id_rsa*
id_ed25519*

# Historical reports contain machine/network details; keep test code only.
/tests/*.md
!/tests/README.md
/integration/*.md
!/integration/README.md
